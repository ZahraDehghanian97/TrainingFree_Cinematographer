{
  "name": "trainingfree_cinematographer",
  "version": "1.0.0",
  "description": "Two shared cinematic environments: athletics/football stadium and operational factory, with deterministic event animation and automatic camera direction",
  "main": "./src/index.ts",
  "scripts": {
    "build": "npm run build:node && npm run build:web",
    "clean:node": "ts-node ./scripts/clean-node-build.ts",
    "build:node": "npm run clean:node && tsc -p tsconfig.json",
    "build:web": "vite build --config web/vite.config.ts --configLoader runner",
    "start": "ts-node ./src/index.ts",
    "pipeline": "ts-node ./src/index.ts",
    "generate:trajectories": "ts-node ./scripts/generate-optimized-trajectories.ts",
    "generate:timelines": "ts-node ./scripts/generate-optimized-trajectories.ts --timeline-only",
    "generate:dont-care": "ts-node ./scripts/generate-optimized-trajectories.ts --suite dont-care",
    "benchmark:optimizer": "ts-node ./scripts/benchmark-optimizer.ts",
    "visualizer": "vite --config web/vite.config.ts --configLoader runner",
    "preview:visualizer": "vite preview --config web/vite.config.ts --configLoader runner",
    "test": "npm run test:node && vitest run --config web/vitest.config.ts --configLoader runner --passWithNoTests",
    "test:node": "node --test -r ts-node/register tests/*.test.ts",
    "audit:motion": "ts-node scripts/audit-environments.ts",
    "generate:assets": "python3 scripts/generate-scene-assets.py",
    "generate:references": "python3 scripts/generate-two-environments.py",
    "generate:examples": "npm run generate:assets && npm run generate:environments && npm run audit:environments && npm run audit:references",
    "audit:references": "ts-node scripts/audit-references.ts --strict",
    "benchmark:references": "ts-node scripts/benchmark-references.ts",
    "typecheck:references": "tsc -p tsconfig.references.json",
    "test:references": "node --test -r ts-node/register tests/reference*.test.ts",
    "audit:environments": "ts-node scripts/audit-environments.ts",
    "test:environments": "node --test -r ts-node/register tests/environment-layout.test.ts",
    "generate:environments": "python3 scripts/generate-two-environments.py",
    "typecheck:scenarios": "tsc -p tsconfig.scenarios.json",
    "test:scenarios": "node --test -r ts-node/register tests/scenario-motion.test.ts tests/environment-layout.test.ts tests/reference-generation.test.ts",
    "test:offline": "npm run typecheck:scenarios && npm run test:node",
    "check:syntax": "node scripts/check-typescript-syntax.cjs",
    "smoke:optimizer": "ts-node scripts/smoke-two-environments.ts"
  },
  "keywords": [],
  "author": "",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "@types/node": "^25.3.2",
    "@types/three": "^0.185.1",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3",
    "vite": "^8.1.5",
    "vitest": "^4.1.10"
  },
  "dependencies": {
    "ai": "^7.0.70",
    "global-agent": "^3.0.0",
    "sharp": "^0.34.5",
    "three": "^0.185.1",
    "undici": "^6.28.0",
    "zod": "^3.25.76",
    "zod-to-json-schema": "^3.24.6"
  }
}
