{
  "name": "trainingfree_cinematographer",
  "version": "1.0.0",
  "description": "Training-free camera direction DSL, timeline solver, and 4D trajectory visualizer",
  "main": "./src/index.ts",
  "scripts": {
    "build": "npm run build:node && npm run build:web",
    "build:node": "tsc -p tsconfig.json",
    "build:web": "vite build --config web/vite.config.ts",
    "start": "ts-node ./src/index.ts",
    "pipeline": "ts-node ./src/index.ts",
    "visualizer": "vite --config web/vite.config.ts",
    "preview:visualizer": "vite preview --config web/vite.config.ts",
    "test": "npm run test:node && vitest run --config web/vitest.config.ts --passWithNoTests",
    "ai_trajectory": "ts-node src/opt/ai_trajectory_generator_pipeline/index.ts",
    "test:node": "node --test -r ts-node/register tests/*.test.ts"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "@types/node": "^25.3.2",
    "@types/three": "^0.185.1",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3",
    "vite": "^8.1.5",
    "vitest": "^4.1.10"
  },
  "dependencies": {
    "ai": "^7.0.70",
    "global-agent": "^3.0.0",
    "sharp": "^0.34.5",
    "three": "^0.185.1",
    "undici": "^6.28.0",
    "zod": "^3.25.76",
    "zod-to-json-schema": "^3.24.6"
  }
}
