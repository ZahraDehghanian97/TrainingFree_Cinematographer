    "durationSeconds": 18,
    "timeDomain": "playback",
    "fpsHint": 24
  },
  "coordinates": {
    "handedness": "right",
    "upAxis": "+Y",
    "cameraForwardAxis": "-Z",
    "lengthUnit": "meter",
    "rotationOrder": "quaternion-xyzw"
  },
