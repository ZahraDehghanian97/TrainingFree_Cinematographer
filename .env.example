# Required for local AI Gateway calls. Vercel deployments can use OIDC instead.
AI_GATEWAY_API_KEY=your_ai_gateway_api_key

# Backward-compatible fallback used when a stage-specific model is omitted.
LLM_MODEL=zai/glm-5.3-flash

# Interactive prompt pipeline models. These are independent and may point to
# different AI Gateway providers/models.
LLM_CSL_MODEL=zai/glm-5.3-flash
LLM_GROUNDING_MODEL=zai/glm-5.3-flash
LLM_REPAIR_MODEL=zai/glm-5.3-flash

# Optional override for the legacy/general environment-query parser.
LLM_ENVIRONMENT_QUERY_MODEL=zai/glm-5.3-flash

# Total LLM deadline, transport retries, and bounded domain/schema repair pass.
LLM_TIMEOUT_MS=180000
LLM_MAX_TRANSPORT_RETRIES=2
LLM_MAX_REPAIR_ATTEMPTS=1

# Camera Lab prompt runs use an interactive optimizer budget (CLI defaults are separate).
PIPELINE_OPTIMIZER_ITERATIONS=500
PIPELINE_MAX_CONCURRENT_RUNS=2

# Example pipeline subject binding: resolved (direct known IDs) or llm.
EXAMPLE_BINDING_MODE=resolved

# Optional custom Gateway-compatible deployment.
# AI_GATEWAY_BASE_URL=https://ai-gateway.vercel.sh/v4/ai
